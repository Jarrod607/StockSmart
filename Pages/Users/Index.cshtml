@page
@model StockSmart.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mt-3 mb-3">
   <h1 class="h3 mb-0">Users</h1>
    <a asp-page="/Users/Create" class="btn btn-primary">Add user</a>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success" role="alert">@Model.StatusMessage</div>
}
@if (!string.IsNullOrEmpty(Model.WarningMessage))
{
    <div class="alert alert-warning" role="alert">@Model.WarningMessage</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Username</th>
            <th>Role</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model.Users)
        {
            <tr>
                <td>
                    @u.Username
                    @if (u.UserId == Model.CurrentUserId)
                    {
                        <span class="text-muted">(you)</span>
                    }
                </td>
                <td>@u.Role</td>
                <td>
                    @if (u.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Deactivated</span>
                    }
                </td>
                <td class="text-end">
                    @if (u.UserId == Model.CurrentUserId)
                    {
                        <span class="text-muted small me-2">Your account</span>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="SetActive"
                              asp-route-id="@u.UserId" asp-route-active="@(!u.IsActive)" class="d-inline">
                            @if (u.IsActive)
                            {
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Deactivate @u.Username? They will no longer be able to log in.');">
                                    Deactivate
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-sm btn-outline-success">Reactivate</button>
                            }
                        </form>
                    }
                    <a asp-page="/Users/ResetPassword" asp-route-id="@u.UserId"
                       class="btn btn-sm btn-outline-secondary ms-1">Reset password</a>
                </td>
            </tr>
        }
    </tbody>
</table>
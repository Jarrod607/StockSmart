@page
@model StockSmart.Pages.SaleTestModel
@{
    ViewData["Title"] = "Sales engine test";
}

<h1 class="h3 mb-1">Sales engine test</h1>
<p class="text-muted">Temporary page for tests SA01 and SA02. Removed when the New Sale page is built.</p>

@if (Model.TestName != null)
{
    <div class="alert @(Model.Passed == true ? "alert-success" : "alert-danger")">
        <h2 class="h5">@Model.TestName: @(Model.Passed == true ? "PASS" : "FAIL")</h2>
        <ul class="mb-0">
            @foreach (var line in Model.Results)
            {
                <li>@line</li>
            }
        </ul>
    </div>
}

<div class="d-flex flex-wrap gap-2 mb-4">
    <form method="post" asp-page-handler="Valid">
        <button type="submit" class="btn btn-primary">SA01: Valid sale</button>
    </form>
    <form method="post" asp-page-handler="Rollback">
        <button type="submit" class="btn btn-danger">SA02: Rollback</button>
    </form>
    <form method="post" asp-page-handler="OverStock">
        <button type="submit" class="btn btn-outline-secondary">Service stock check</button>
    </form>
</div>

<div class="row">
    <div class="col-md-7">
        <h2 class="h6">Current stock (active products)</h2>
        <table class="table table-sm">
            <thead>
                <tr><th>Product</th><th class="text-end">Quantity</th></tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Products)
                {
                    <tr><td>@p.Name</td><td class="text-end">@p.Quantity</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="col-md-5">
        <h2 class="h6">Database rows</h2>
        <table class="table table-sm">
            <tbody>
                <tr><td>Sale</td><td class="text-end">@Model.SaleCount</td></tr>
                <tr><td>SaleItem</td><td class="text-end">@Model.SaleItemCount</td></tr>
            </tbody>
        </table>
    </div>
</div>
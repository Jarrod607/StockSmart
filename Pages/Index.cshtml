@page
@model StockSmart.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
    var isManager = User.IsInRole("Manager");
}

<h1 class="h3 mb-1">Dashboard</h1>
<p class="text-muted mb-4">Welcome, @User.Identity?.Name.</p>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Active products</div>
                <div class="display-6">@Model.ProductCount</div>
                <a asp-page="/Products/Index" class="small">View products</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 @(Model.LowStock.Count > 0 ? "border-warning" : "")">
            <div class="card-body">
                <div class="text-muted small">Low stock</div>
                <div class="display-6">@Model.LowStock.Count</div>
                   <a asp-page="/LowStock" class="small">View low stock</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Suppliers</div>
                <div class="display-6">@Model.SupplierCount</div>
                <a asp-page="/Suppliers/Index" class="small">View suppliers</a>
            </div>
        </div>
    </div>
</div>

<h2 class="h5">Quick links</h2>
<div class="d-flex flex-wrap gap-2 mb-4">
    <a asp-page="/Sales/New" class="btn btn-primary">New Sale</a>
    <a asp-page="/Products/Index" class="btn btn-outline-secondary">Products</a>
    <a asp-page="/Suppliers/Index" class="btn btn-outline-secondary">Suppliers</a>
    @if (isManager)
    {
        <a asp-page="/Products/Add" class="btn btn-outline-secondary">Add product</a>
        <a asp-page="/Users/Index" class="btn btn-outline-secondary">Users</a>
    }
</div>

@if (Model.LowStock.Count > 0)
{
    <h2 class="h5">Needs reordering</h2>
    <table class="table table-sm align-middle" style="max-width: 40rem;">
        <thead>
            <tr>
                <th>Product</th>
                <th class="text-end">Quantity</th>
                <th class="text-end">Reorder level</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.LowStock)
            {
                <tr>
                    <td>@p.Name</td>
                    <td class="text-end">@p.Quantity</td>
                    <td class="text-end">@p.ReorderLevel</td>
                </tr>
            }
        </tbody>
    </table>
}
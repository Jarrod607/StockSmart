@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="h3 mb-3 text-danger">Something went wrong</h1>

<p>StockSmart could not complete your request. Please try again.</p>
<p>If the problem continues, ask the Manager to check that the database is running.</p>

@if (Model.ShowRequestId)
{
    <p class="small text-muted">Reference: <code>@Model.RequestId</code></p>
}

<a class="btn btn-outline-secondary" asp-page="/Index">Back to the dashboard</a>
@page
@model StockSmart.Pages.ReportsModel
@{
    ViewData["Title"] = "Sales reports";
}

<h1 class="h3 mb-3">Sales reports</h1>

<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-auto">
        <label for="date" class="form-label">Date</label>
        <input type="date" id="date" name="date" class="form-control"
               value="@Model.Date?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-auto">
        <label for="period" class="form-label">Report</label>
        <select id="period" name="period" class="form-select">
            <option value="day" selected="@(!Model.IsWeek)">Daily</option>
            <option value="week" selected="@Model.IsWeek">Weekly (Mon to Sun)</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Show report</button>
    </div>
</form>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
else if (Model.Report != null)
{
    var r = Model.Report;
    <h2 class="h5 mb-3">@(Model.IsWeek ? "Weekly" : "Daily") report: @Model.RangeLabel</h2>

    if (r.SaleCount == 0)
    {
        <div class="alert alert-info">No sales were recorded for this @(Model.IsWeek ? "week" : "day").</div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card h-100"><div class="card-body">
                    <div class="text-muted small">Number of sales</div>
                    <div class="display-6">@r.SaleCount</div>
                </div></div>
            </div>
            <div class="col-md-4">
                <div class="card h-100"><div class="card-body">
                    <div class="text-muted small">Total sales</div>
                    <div class="display-6">R@(r.TotalSales.ToString("0.00"))</div>
                </div></div>
            </div>
            <div class="col-md-4">
                <div class="card h-100"><div class="card-body">
                    <div class="text-muted small">Items sold</div>
                    <div class="display-6">@r.ItemsSold</div>
                </div></div>
            </div>
        </div>

        <h3 class="h6">Best sellers (top 5 by quantity)</h3>
        <table class="table table-sm align-middle mb-4" style="max-width: 40rem;">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Product</th>
                    <th class="text-end">Quantity sold</th>
                    <th class="text-end">Revenue</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in r.BestSellers)
                {
                    <tr>
                        <td>@(r.BestSellers.IndexOf(b) + 1)</td>
                        <td>@b.ProductName</td>
                        <td class="text-end">@b.QuantitySold</td>
                        <td class="text-end">R@(b.Revenue.ToString("0.00"))</td>
                    </tr>
                }
            </tbody>
        </table>

        if (Model.IsWeek)
        {
            <h3 class="h6">Day by day</h3>
            <table class="table table-sm align-middle" style="max-width: 40rem;">
                <thead>
                    <tr>
                        <th>Day</th>
                        <th class="text-end">Sales</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in r.DailyTotals)
                    {
                        <tr>
                            <td>@d.Day.ToString("ddd d MMM")</td>
                            <td class="text-end">@d.SaleCount</td>
                            <td class="text-end">R@(d.Total.ToString("0.00"))</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td>Week total</td>
                        <td class="text-end">@r.SaleCount</td>
                        <td class="text-end">R@(r.TotalSales.ToString("0.00"))</td>
                    </tr>
                </tfoot>
            </table>
        }
    }
}
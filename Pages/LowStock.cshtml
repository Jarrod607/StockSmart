@page
@model StockSmart.Pages.LowStockModel
@using StockSmart.Models
@{
    ViewData["Title"] = "Low stock";
    bool isManager = User.IsInRole(UserRoles.Manager);
}

<h1 class="h3 mb-1">Low stock</h1>
<p class="text-muted mb-3">Active products at or below their reorder level, with the supplier to contact.</p>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
else if (!Model.Items.Any())
{
    <div class="alert alert-success">All products are above their reorder level. Nothing needs reordering.</div>
}
else
{
    <div class="alert alert-warning">
        @Model.Items.Count product@(Model.Items.Count == 1 ? "" : "s") need@(Model.Items.Count == 1 ? "s" : "") reordering.
    </div>

    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th>Product</th>
                <th>Category</th>
                <th class="text-end">Quantity</th>
                <th class="text-end">Reorder level</th>
                <th>Supplier</th>
                <th>Phone</th>
                <th>Email</th>
                @if (isManager) { <th></th> }
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Items)
            {
                var s = Model.SupplierFor(p.SupplierId);
                <tr>
                    <td>
                        @p.Name
                        @if (p.Quantity == 0)
                        {
                            <span class="badge bg-danger ms-1">Out of stock</span>
                        }
                    </td>
                    <td>@(p.Category ?? "-")</td>
                    <td class="text-end">@p.Quantity</td>
                    <td class="text-end">@p.ReorderLevel</td>
                    <td>@(s?.Name ?? "-")</td>
                    <td>
                        @if (!string.IsNullOrEmpty(s?.Phone)) { <a href="tel:@s.Phone">@s.Phone</a> } else { <span>-</span> }
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(s?.Email)) { <a href="mailto:@s.Email">@s.Email</a> } else { <span>-</span> }
                    </td>
                    @if (isManager)
                    {
                        <td><a asp-page="/Products/Edit" asp-route-id="@p.ProductId" class="btn btn-sm btn-outline-secondary">Edit</a></td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
@page
@model StockSmart.Pages.Products.IndexModel
@using StockSmart.Models
@{
    ViewData["Title"] = "Products";
    bool isManager = User.IsInRole(UserRoles.Manager);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Products</h1>
    @if (isManager)
    {
        <a class="btn btn-primary" href="/Products/Add">Add product</a>
    }
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
else if (!Model.ProductList.Any())
{
    <p class="text-muted">No products found.</p>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th>Supplier</th>
                <th class="text-end">Price</th>
                <th class="text-end">Quantity</th>
                <th class="text-end">Reorder level</th>
                @if (isManager)
                {
                    <th></th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.ProductList)
            {
                <tr>
                    <td>@p.Name</td>
                    <td>@(p.Category ?? "—")</td>
                    <td>@Model.SupplierName(p.SupplierId)</td>
                    <td class="text-end">R @p.Price.ToString("0.00")</td>
                    <td class="text-end">@p.Quantity</td>
                    <td class="text-end">@p.ReorderLevel</td>
                    @if (isManager)
                    {
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" href="/Products/Edit?id=@p.ProductId">Edit</a>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
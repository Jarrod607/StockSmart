@page
@model StockSmart.Pages.Suppliers.DetailsModel
@{
    ViewData["Title"] = Model.Supplier?.Name ?? "Supplier";
}

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (Model.Supplier != null)
{
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h1 class="h3 mb-0">@Model.Supplier.Name</h1>
        @if (User.IsInRole("Manager"))
        {
            <a asp-page="Edit" asp-route-id="@Model.Supplier.SupplierId" class="btn btn-outline-secondary">Edit supplier</a>
        }
    </div>
    <p class="text-muted">
        Phone: @(Model.Supplier.Phone ?? "—") · Email: @(Model.Supplier.Email ?? "—")
    </p>

    <h2 class="h5 mt-4">Products from this supplier</h2>

    @if (Model.ProductList.Count == 0)
    {
        <p class="text-muted">No active products are linked to this supplier yet.</p>
    }
    else
    {
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Category</th>
                    <th class="text-end">Price</th>
                    <th class="text-end">Quantity</th>
                    <th class="text-end">Reorder level</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.ProductList)
                {
                    <tr>
                        <td>@p.Name</td>
                        <td>@(p.Category ?? "—")</td>
                        <td class="text-end">R @p.Price.ToString("0.00")</td>
                        <td class="text-end">@p.Quantity</td>
                        <td class="text-end">@p.ReorderLevel</td>
                        <td>
                            @if (p.IsLowStock)
                            {
                                <span class="badge bg-warning text-dark">Low stock</span>
                            }
                            else
                            {
                                <span class="badge bg-success">In stock</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

<a asp-page="Index" class="btn btn-outline-secondary mt-2">Back to suppliers</a>